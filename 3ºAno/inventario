SALAS = ('LAB1', 'LAB2', 'LAB3')
ESTADOS = ('operacional', 'avariado', 'em reparação')
tipos = ['computador', 'monitor', 'impressora', 'router', 'switch']

# Dicionário 
inventario = {
    'PC01': {
        'nome': 'desktop hp elitedesk',
        'tipo': 'computador',
        'sala': 'LAB1',
        'quantidade': 12,
        'estado': 'operacional'
    },
    'MON01': {
        'nome': 'monitor samsung',
        'tipo': 'monitor',
        'sala': 'LAB1',
        'quantidade': 10,
        'estado': 'operacional'
    },
    'IMP01': {
        'nome': 'impressora laser brother',
        'tipo': 'impressora',
        'sala': 'LAB2',
        'quantidade': 2,
        'estado': 'avariado'
    },
    'RTR01': {
        'nome': 'router cisco',
        'tipo': 'router',
        'sala': 'LAB2',
        'quantidade': 1,
        'estado': 'operacional'
    },
    'SWT01': {
        'nome': 'switch cisco 24 portas',
        'tipo': 'switch',
        'sala': 'LAB3',
        'quantidade': 2,
        'estado': 'avariado'
    },
    'PC02': {
        'nome': 'computador hp',
        'tipo': 'computador',
        'sala': 'LAB3',
        'quantidade': 8,
        'estado': 'operacional'
    }
}

# Listas de apoio e histórico
lista_reparacao = []
reparados = []
historico = []



for id_equipamento in inventario:
    if inventario[id_equipamento]['estado'] == 'avariado':
        lista_reparacao.append(id_equipamento)

# Construção do menu interativo linha a linha
menu = ''
menu += '\n1 - Listar equipamentos\n'
menu += '2 - Adicionar equipamento\n'
menu += '3 - Pesquisar equipamento\n'
menu += '4 - Alterar estado de um equipamento\n'
menu += '5 - Remover equipamento\n'
menu += '6 - Lista de reparação\n'
menu += '7 - Estatísticas\n'
menu += '8 - Histórico de operações\n'
menu += '0 - Sair\n'

ativo = True

while ativo:
    print('\n========== GESTOR DE INVENTÁRIO ==========')
    print(menu)
    opcao = input('Escolha uma opção: ').strip()

    # OPÇÃO 0: Sair do programa
    if opcao == '0':
        sair = input('Deseja sair? (s/n): ').strip().lower()
        if sair == 's':
            ativo = False
            print('Terminado.')
        else:
            print('Regresso ao menu.')

    # OPÇÃO 1: Listar equipamentos
    elif opcao == '1':
        if len(inventario) == 0:
            print('Não existem itens no inventário.')
        else:
            print('CÓDIGO | NOME | SALA | QUANTIDADE | ESTADO')
            for id_equipamento in sorted(inventario):
                equipamento = inventario[id_equipamento]
                print(
                    f"{id_equipamento} | {equipamento['nome'].title()} | "
                    f"{equipamento['sala']} | {equipamento['quantidade']} un. | "
                    f"{equipamento['estado']}"
                )
            print(f'\nTotal de registos: {len(inventario)}')

    # OPÇÃO 2: Adicionar novo equipamento
    elif opcao == '2':
        id_ = input('ID: ').strip().upper()
        if id_ == '' or id_ in inventario:
            print('ID inválido ou já existente.')
        else:
            nome = input('Nome: ').strip()
            while nome == '':
                nome = input('Nome: ').strip()

            print(f'Tipos aceites: {tipos}')
            tipo = input('Tipo: ').strip().lower()
            while tipo not in tipos:
                print('Tipo inválido.')
                tipo = input('Tipo: ').strip().lower()

            sala = input('Sala: ').strip().upper()
            while sala not in SALAS:
                print('Sala inválida.')
                sala = input('Sala: ').strip().upper()

            quantidade = int(input('Quantidade: '))
            while quantidade <= 0:
                print('A quantidade deve ser maior que zero.')
                quantidade = int(input('Quantidade: '))

            inventario[id_] = {
                'nome': nome,
                'tipo': tipo,
                'sala': sala,
                'quantidade': quantidade,
                'estado': 'operacional'
            }

            historico.append(f'Adicionado {id_}')
            print('Equipamento adicionado com sucesso.')

    # OPÇÃO 3: Pesquisar equipamento por ID
    elif opcao == '3':
        id_ = input('ID: ').strip().upper()
        equipamento = inventario.get(id_)

        if equipamento is None:
            print('Equipamento não encontrado.')
        else:
            print(f'\nID: {id_}')
            for chave in equipamento:
                print(f'{chave}: {equipamento[chave]}')

    # OPÇÃO 4: Alterar o estado de um equipamento
    elif opcao == '4':
        id_ = input('ID: ').strip().upper()
        equipamento = inventario.get(id_)

        if equipamento is None:
            print('Equipamento não encontrado.')
        else:
            print(f"Estado atual: {equipamento['estado']}")
            print(f'Estados possíveis: {ESTADOS}')
            estado = input('Novo estado: ').strip().lower()

            while estado not in ESTADOS:
                print('Estado inválido.')
                estado = input('Novo estado: ').strip().lower()

            estado_anterior = equipamento['estado']

            if estado == estado_anterior:
                print('O estado já é esse.')
            else:
                inventario[id_]['estado'] = estado

                if estado == 'avariado':
                    if id_ not in lista_reparacao:
                        lista_reparacao.append(id_)
                else:
                    while id_ in lista_reparacao:
                        lista_reparacao.remove(id_)

                historico.append(f'Estado de {id_}: {estado_anterior} -> {estado}')
                print('Estado alterado com sucesso.')

    # OPÇÃO 5: Remover equipamento
    elif opcao == '5':
        id_ = input('ID: ').strip().upper()
        equipamento = inventario.get(id_)

        if equipamento is None:
            print('Equipamento não encontrado.')
        else:
            print(f"Equipamento: {equipamento['nome']}")
            confirmar = input('Tem a certeza que deseja remover? (s/n): ').strip().lower()

            if confirmar == 's':
                del inventario[id_]
                while id_ in lista_reparacao:
                    lista_reparacao.remove(id_)

                historico.append(f'Removido {id_}')
                print('Equipamento removido com sucesso.')
            else:
                print('Equipamento não removido.')

    # OPÇÃO 6: Gerir lista de reparações
    elif opcao == '6':
        if len(lista_reparacao) == 0:
            print('Não existem equipamentos em reparação.')
        else:
            print('Equipamentos a aguardar reparação (por ordem):')
            numero = 1
            for id_equipamento in lista_reparacao:
                equipamento = inventario[id_equipamento]
                print(
                    f"{numero}. {id_equipamento} - {equipamento['nome'].title()} "
                    f"({equipamento['sala']} - {equipamento['quantidade']} un.)"
                )
                numero += 1

            processar = input('Processar todas as reparações? (s/n): ').strip().lower()

            if processar == 's':
                while len(lista_reparacao) > 0:
                    id_ = lista_reparacao.pop(0)
                    inventario[id_]['estado'] = 'operacional'
                    reparados.append(id_)
                    historico.append(f'Reparação concluída: {id_}')
                    print(f'A reparar {id_}...')

                print('Todas as reparações foram concluídas.')
                print(f'Equipamentos reparados nesta sessão: {reparados}')

    # OPÇÃO 7: Mostrar estatísticas do inventário
    elif opcao == '7':
        if len(inventario) == 0:
            print('Não existem equipamentos no inventário.')
        else:
            print(f'Número de registos: {len(inventario)}')

            quantidades = [
                equipamento['quantidade']
                for equipamento in inventario.values()
            ]

            print(f'Total de unidades: {sum(quantidades)}')
            print(f'Maior quantidade: {max(quantidades)}')
            print(f'Menor quantidade: {min(quantidades)}')

            tipos_existentes = set()
            for id_equipamento in inventario:
                inventario_tipo = inventario[id_equipamento]['tipo']
                tipos_existentes.add(inventario_tipo)

            tipos_existentes = sorted(tipos_existentes)
            print(f'Tipos existentes: {tipos_existentes}')

            estados_contagem = {}
            for id_equipamento in inventario:
                estado = inventario[id_equipamento]['estado']
                if estado not in estados_contagem:
                    estados_contagem[estado] = 1
                else:
                    estados_contagem[estado] += 1

            print(f'Registos por estado: {estados_contagem}')

            for sala in SALAS:
                quantidade_sala = 0
                for id_equipamento in inventario:
                    equipamento = inventario[id_equipamento]
                    if equipamento['sala'] == sala:
                        quantidade_sala += equipamento['quantidade']

                print(f'Total de unidades em {sala}: {quantidade_sala}')

    # OPÇÃO 8: Consultar histórico de operações
    elif opcao == '8':
        if len(historico) == 0:
            print('Não existem operações no histórico.')
        else:
            print('Últimas operações:')
            ultimas = historico[-5:]
            for operacao in ultimas:
                print(f'- {operacao}')

            print(f'Total de operações: {len(historico)}')

    # Validação de opção inválida no menu
    else:
        print('Opção inválida. Tente novamente.')
