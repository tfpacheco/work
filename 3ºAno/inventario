SALAS = ('LAB1', 'LAB2', 'LAB3')

ESTADOS = ('operacional', 'avariado', 'em reparação')

tipos = ['computador', 'monitor', 'impressora', 'router', 'switch']


inventario = {
    'PC01': {
        'nome': 'computador dell',
        'tipo': 'computador',
        'sala': 'LAB1',
        'quantidade': 10,
        'estado': 'operacional'
    },
    'MON01': {
        'nome': 'monitor samsung',
        'tipo': 'monitor',
        'sala': 'LAB1',
        'quantidade': 10,
        'estado': 'operacional'
    },
    'IMP01': {
        'nome': 'impressora hp',
        'tipo': 'impressora',
        'sala': 'LAB2',
        'quantidade': 2,
        'estado': 'avariado'
    },
    'RTR01': {
        'nome': 'router cisco',
        'tipo': 'router',
        'sala': 'LAB2',
        'quantidade': 1,
        'estado': 'operacional'
    },
    'SWT01': {
        'nome': 'switch tp-link',
        'tipo': 'switch',
        'sala': 'LAB3',
        'quantidade': 2,
        'estado': 'avariado'
    },
    'PC02': {
        'nome': 'computador hp',
        'tipo': 'computador',
        'sala': 'LAB3',
        'quantidade': 8,
        'estado': 'operacional'
    }
}



lista_reparacao = []
reparados = []
historico = []



for id_equipamento in inventario:
    if inventario[id_equipamento]['estado'] == 'avariado':
        lista_reparacao.append(id_equipamento)


menu = ''

menu += '\n1 - Listar Equipamentos\n'
menu += '2 - Adicionar Equipamentos\n'
menu += '3 - Procurar Equipamento\n'
menu += '4 - Alterar estado de um Equipamento\n'
menu += '5 - Remover Equipamento\n'
menu += '6 - Lista de Reparações\n'
menu += '7 - Estatísticas\n'
menu += '8 - Histórico de operações\n'
menu += '0 - Sair\n'




ativo = True

while ativo:

    print('\n========= Gestor de Inventário =========')
    print(menu)

    opcao = input('Opção: ')


  

    if opcao == '0':
        sair = input('Deseja sair? S ou N: ').strip().upper()
        if sair == 'S':
            ativo = False
            print('Terminado.')
        else:
            print('Regresso ao menu.')


   

    elif opcao == '1':
        if len(inventario) == 0:
            print('Não existem itens no inventário.')
        else:
            print('CÓDIGO | NOME | SALA | QUANTIDADE | ESTADO')

            for id_equipamento in sorted(inventario):
                equipamento = inventario[id_equipamento]

                print(
                    id_equipamento,
                    '|',
                    equipamento['nome'].title(),
                    '|',
                    equipamento['sala'],
                    '|',
                    equipamento['quantidade'],
                    '|',
                    equipamento['estado']
                )

            print('\nTotal de registos:', len(inventario))




    elif opcao == '2':

        codigo = input('Código: ').strip().upper()

        if codigo == '' or codigo in inventario:
            print('Código inválido ou já existente.')

        else:
            nome = input('Nome: ').strip()

            while nome == '':
                nome = input('Nome: ').strip()

            print('Tipos:', tipos)

            tipo = input('Tipo: ').strip().lower()

            while tipo not in tipos:
                print('Tipo inválido.')
                tipo = input('Tipo: ').strip().lower()

            sala = input('Sala: ').strip().upper()

            while sala not in SALAS:
                print('Sala inválida.')
                sala = input('Sala: ').strip().upper()

            quantidade = int(input('Quantidade: '))

            while quantidade <= 0:
                quantidade = int(input('Quantidade: '))

            inventario[codigo] = {
                'nome': nome,
                'tipo': tipo,
                'sala': sala,
                'quantidade': quantidade,
                'estado': 'operacional'
            }

            historico.append('Adicionado ' + codigo)

            print('Adicionado com sucesso.')




    elif opcao == '3':

        codigo = input('Código: ').strip().upper()

        equipamento = inventario.get(codigo)

        if equipamento is None:
            print('Equipamento não encontrado.')

        else:
            print('Código:', codigo)

            for chave in equipamento:
                print(chave + ':', equipamento[chave])




    elif opcao == '4':

        codigo = input('Código: ').strip().upper()

        equipamento = inventario.get(codigo)

        if equipamento is None:
            print('Equipamento não encontrado.')

        else:
            print('Estado atual:', equipamento['estado'])
            print('Estados possíveis:', ESTADOS)

            estado = input('Novo estado: ').strip().lower()

            while estado not in ESTADOS:
                print('Estado inválido.')
                estado = input('Novo estado: ').strip().lower()

            estado_anterior = equipamento['estado']

            if estado == estado_anterior:
                print('O estado já é esse.')

            else:
                inventario[codigo]['estado'] = estado

                if estado == 'avariado':

                    if codigo not in lista_reparacao:
                        lista_reparacao.append(codigo)

                else:

                    while codigo in lista_reparacao:
                        lista_reparacao.remove(codigo)

                historico.append(
                    'Alterado estado de ' + codigo + ' para ' + estado
                )

                print('Estado alterado com sucesso.')


  

    elif opcao == '5':

        codigo = input('Código: ').strip().upper()

        equipamento = inventario.get(codigo)

        if equipamento is None:
            print('Equipamento não encontrado.')

        else:
            print('Equipamento:', equipamento['nome'])

            confirmar = input(
                'Tem a certeza que deseja remover? S ou N: '
            ).strip().upper()

            if confirmar == 'S':

                del inventario[codigo]

                while codigo in lista_reparacao:
                    lista_reparacao.remove(codigo)

                historico.append('Removido ' + codigo)

                print('Equipamento removido com sucesso.')

            else:
                print('Equipamento não removido.')




    elif opcao == '6':

        if len(lista_reparacao) == 0:
            print('Não existem equipamentos em reparação.')

        else:
            print('Equipamentos em reparação:')

            numero = 1

            for id_equipamento in lista_reparacao:

                equipamento = inventario[id_equipamento]

                print(
                    numero,
                    '-',
                    id_equipamento,
                    '|',
                    equipamento['nome'].title(),
                    '|',
                    equipamento['sala'],
                    '|',
                    equipamento['quantidade'],
                    '|',
                    equipamento['estado']
                )

                numero += 1

            processar = input(
                'Deseja processar todas as reparações? S ou N: '
            ).strip().upper()

            if processar == 'S':

                while len(lista_reparacao) > 0:

                    codigo = lista_reparacao.pop(0)

                    inventario[codigo]['estado'] = 'operacional'

                    reparados.append(codigo)

                    historico.append(
                        'Reparação concluída: ' + codigo
                    )

                print('Todas as reparações foram concluídas.')

                print('Equipamentos reparados:')

                for codigo in reparados:
                    print('-', codigo)


  

    elif opcao == '7':

        if len(inventario) == 0:
            print('Não existem equipamentos no inventário.')

        else:
            print('Número de registos:', len(inventario))

       

            quantidades = [
                equipamento['quantidade']
                for equipamento in inventario.values()
            ]

            print('Total de unidades:', sum(quantidades))
            print('Maior quantidade:', max(quantidades))
            print('Menor quantidade:', min(quantidades))


   

            tipos_existentes = set()

            for id_equipamento in inventario:
                tipos_existentes.add(
                    inventario[id_equipamento]['tipo']
                )

            tipos_existentes = sorted(tipos_existentes)

            print('Tipos existentes:', tipos_existentes)


        

            estados_contagem = {}
            for id_equipamento in inventario:
                estado = inventario[id_equipamento]['estado']

                if estado not in estados_contagem:
                    estados_contagem[estado] = 1
                else:
                    estados_contagem[estado] += 1

            print('Registos por estado:', estados_contagem)


         

            for sala in SALAS:
                quantidade_sala = 0
                for id_equipamento in inventario:
                    equipamento = inventario[id_equipamento]
                    if equipamento['sala'] == sala:
                        quantidade_sala += equipamento['quantidade']

                print(
                    'Total de unidades em',
                    sala + ':',
                    quantidade_sala
                )


  

    elif opcao == '8':
        if len(historico) == 0:
            print('Não existem operações no histórico.')
        else:
            print('Últimas operações:')
            ultimas = historico[-5:]
            for operacao in ultimas:
                print('-', operacao)

            print('Total de operações:', len(historico))
    else:
        print('Opção inválida. Tente novamente.')
